---
// src/pages/rede-colaborativa.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Rede Colaborativa — Kaipê Studio"
  description="Plataforma colaborativa para artistas digitais, desenvolvedores de jogos e produtores culturais. Conecte-se, compartilhe projetos, participe de oficinas e construa em rede com o Coletivo K.P."
>
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden pt-24 pb-16 px-6" style="background: linear-gradient(135deg, #FDF6E3 0%, #FAF3E0 100%); border-bottom: 2px solid #2C1F15;">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="container mx-auto text-center max-w-4xl relative z-10">
      <span class="text-xs font-mono font-semibold uppercase tracking-widest" style="color: #5C6B4F;">Colaboração</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mt-3 tracking-tight" style="color: #2C1F15;">Rede <span class="gradient-text">Colaborativa</span></h1>
      <p class="text-lg mt-6 max-w-2xl mx-auto" style="color: #4A3728; opacity: 0.8;">Conectamos artistas, desenvolvedores e produtores culturais para criar juntos.</p>
    </div>
  </section>

  <section class="py-20 px-6" style="background: #FAF3E0;">
    <div class="container mx-auto max-w-4xl text-center">
      <div class="rounded-3xl p-12" style="background: #FDF6E3; border: 2px solid #2C1F15; box-shadow: 6px 6px 0 #2C1F15;">
        <span class="text-6xl block mb-6">🤝</span>
        <h2 class="text-2xl font-black mb-4" style="color: #2C1F15;">Em construção</h2>
        <p class="text-lg" style="color: #4A3728; opacity: 0.8;">
          Nossa plataforma colaborativa está sendo desenvolvida para conectar artistas digitais, 
          desenvolvedores de jogos e produtores culturais de todo o Brasil.
        </p>
        <p class="text-lg mt-4" style="color: #4A3728; opacity: 0.8;">
          Em breve, um espaço para compartilhar projetos, participar de oficinas e construir em rede.
        </p>
      </div>
    </div>
  </section>
</Layout>