---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contato - Kaipê Studio" description="Fale com a Kaipê Studio sobre projetos de games, produção cultural, parcerias educacionais e colaborações artísticas.">
  <!-- Hero Section -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden pt-24 pb-16 px-6" style="background: linear-gradient(135deg, #FDF6E3 0%, #FAF3E0 100%); border-bottom: 2px solid #2C1F15;">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    
    <div class="container mx-auto text-center max-w-4xl relative z-10">
      <span class="text-xs font-mono font-semibold uppercase tracking-widest" style="color: #C75B39;">Contato</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mt-3 tracking-tight" style="color: #2C1F15;">
        Vamos criar algo <span class="gradient-text">incrível</span> juntos?
      </h1>
      <p class="text-lg mt-6 max-w-2xl mx-auto" style="color: #4A3728; opacity: 0.8;">
        Fale conosco e descubra como podemos colaborar em projetos culturais, educacionais e de desenvolvimento de jogos.
      </p>
    </div>
  </section>

  <!-- Conteúdo -->
  <section class="py-16 px-6" style="background: #FAF3E0;">
    <div class="container mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Info Card -->
        <div class="rounded-3xl p-10" style="background: #FDF6E3; border: 2px solid #2C1F15; box-shadow: 6px 6px 0 #2C1F15;">
          <h2 class="text-2xl font-black mb-6" style="color: #2C1F15;">Informações</h2>
          
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl" style="background: rgba(199,91,57,0.15);">📧</div>
              <div>
                <p class="text-sm" style="color: #4A3728; opacity: 0.6;">Email</p>
                <a href="mailto:kaipestudio@gmail.com" class="font-medium" style="color: #2C1F15;" onmouseover="this.style.color='#C75B39'" onmouseout="this.style.color='#2C1F15'">kaipestudio@gmail.com</a>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl" style="background: rgba(199,91,57,0.15);">📱</div>
              <div>
                <p class="text-sm" style="color: #4A3728; opacity: 0.6;">WhatsApp</p>
                <a href="https://wa.me/556781282388" class="font-medium" style="color: #2C1F15;" onmouseover="this.style.color='#C75B39'" onmouseout="this.style.color='#2C1F15'" target="_blank">(67) 8128-2388</a>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl" style="background: rgba(199,91,57,0.15);">📍</div>
              <div>
                <p class="text-sm" style="color: #4A3728; opacity: 0.6;">Localização</p>
                <p class="font-medium" style="color: #2C1F15;">Dourados, Mato Grosso do Sul</p>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="flex gap-3 mt-8">
            <a href="#" class="w-10 h-10 rounded-lg flex items-center justify-center transition-colors" style="background: #FAF3E0; border: 2px solid #2C1F15;" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='#FAF3E0'" aria-label="Instagram">📸</a>
            <a href="#" class="w-10 h-10 rounded-lg flex items-center justify-center transition-colors" style="background: #FAF3E0; border: 2px solid #2C1F15;" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='#FAF3E0'" aria-label="YouTube">▶️</a>
            <a href="#" class="w-10 h-10 rounded-lg flex items-center justify-center transition-colors" style="background: #FAF3E0; border: 2px solid #2C1F15;" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='#FAF3E0'" aria-label="Twitter">🐦</a>
          </div>
        </div>

        <!-- Form Card -->
        <div class="rounded-3xl p-8" style="background: #FDF6E3; border: 2px solid #2C1F15; box-shadow: 6px 6px 0 #2C1F15;">
          <h3 class="text-xl font-black mb-6" style="color: #2C1F15;">Envie uma mensagem</h3>
          <form class="space-y-4" netlify>
            <div>
              <input 
                type="text" 
                name="nome" 
                required 
                class="w-full px-4 py-3 rounded-xl outline-none transition-all"
                style="background: #FAF3E0; border: 2px solid #E8DFD0; color: #2C1F15;"
                placeholder="Seu nome"
              />
            </div>
            <div>
              <input 
                type="email" 
                name="email" 
                required 
                class="w-full px-4 py-3 rounded-xl outline-none transition-all"
                style="background: #FAF3E0; border: 2px solid #E8DFD0; color: #2C1F15;"
                placeholder="seu@email.com"
              />
            </div>
            <div>
              <textarea 
                name="mensagem" 
                rows="4" 
                required 
                class="w-full px-4 py-3 rounded-xl outline-none transition-all resize-none"
                style="background: #FAF3E0; border: 2px solid #E8DFD0; color: #2C1F15;"
                placeholder="Fale sobre seu projeto..."
              ></textarea>
            </div>
            <button 
              type="submit" 
              class="w-full btn-glow py-3"
            >
              Enviar Mensagem 🚀
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
