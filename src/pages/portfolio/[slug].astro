---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getGradient } from '../../lib/gradients';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const gradient = getGradient(project.data.gradient);
---

<Layout title={`${project.data.title} - Kaipê Studio`} description={project.data.description}>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-end overflow-hidden pt-24 pb-12 px-6" style="background: linear-gradient(135deg, #FDF6E3 0%, #FAF3E0 100%); border-bottom: 2px solid #2C1F15;">
    <!-- Imagem de Fundo -->
    {project.data.image && (
      <div class="absolute inset-0">
        <img 
          src={project.data.image} 
          alt={project.data.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0" style="background: linear-gradient(transparent 20%, rgba(0,0,0,0.9));"></div>
      </div>
    )}
    
    <div class="container mx-auto max-w-4xl relative z-10">
      <a href="/portfolio" class="inline-flex items-center gap-2 text-sm mb-6 transition-colors" style="color: #4A3728; opacity: 0.6;" onmouseover="this.style.opacity='1'; this.style.color='#C75B39'" onmouseout="this.style.opacity='0.6'; this.style.color='#4A3728'">
        ← Voltar ao Portfólio
      </a>
      
      <div class="mb-4">
        <span class="text-xs font-semibold uppercase tracking-wider" style="color: #C75B39;">
          {project.data.year} • {project.data.category}
        </span>
      </div>
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight" style="color: #2C1F15;">{project.data.title}</h1>
      <p class="text-lg mt-4 max-w-2xl" style="color: #4A3728; opacity: 0.8;">
        {project.data.description}
      </p>
    </div>
  </section>

  <!-- Conteúdo -->
  <article class="py-12 px-6" style="background: #FAF3E0;">
    <div class="container mx-auto max-w-3xl">
      <div class="prose prose-lg max-w-none" style="color: #4A3728;">
        <Content />
      </div>
      
      <!-- Navegação -->
      <div class="mt-12 pt-8" style="border-top: 2px solid #E8DFD0;">
        <a href="/portfolio" class="gradient-text font-semibold transition-colors">
          ← Voltar ao Portfólio
        </a>
      </div>
    </div>
  </article>
</Layout>