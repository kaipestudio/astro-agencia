---
// src/components/Header.astro
---

<header class="fixed top-0 left-0 right-0 bg-white/80 backdrop-blur-md z-50 border-b border-gray-100">
  <nav class="container mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold">
      Kaipê <span class="text-blue-600">Studio</span>
    </a>

    <div class="hidden md:flex items-center space-x-6">
      <a href="/" class="text-gray-700 hover:text-blue-600 transition">Início</a>
      <a href="/sobre" class="text-gray-700 hover:text-blue-600 transition">Equipe</a>
      <a href="/portfolio" class="text-gray-700 hover:text-blue-600 transition">Portfólio</a>
      <a href="/blog" class="text-gray-700 hover:text-blue-600 transition">Blog</a>
      <a href="/rede-colaborativa" class="text-gray-700 hover:text-blue-600 transition">Rede Colaborativa</a>
      <a href="/mostra" class="text-gray-700 hover:text-blue-600 transition">Mostra</a>
      <a href="/contato" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
        Contato
      </a>
    </div>

    <button id="menuButton" class="md:hidden text-gray-700 hover:text-blue-600 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobileMenu" class="hidden md:hidden bg-white border-b border-gray-100 px-4 py-4 space-y-3">
    <a href="/" class="block text-gray-700 hover:text-blue-600 transition">Início</a>
    <a href="/sobre" class="block text-gray-700 hover:text-blue-600 transition">Equipe</a>
    <a href="/portfolio" class="block text-gray-700 hover:text-blue-600 transition">Portfólio</a>
    <a href="/blog" class="block text-gray-700 hover:text-blue-600 transition">Blog</a>
    <a href="/rede-colaborativa" class="block text-gray-700 hover:text-blue-600 transition">Rede Colaborativa</a>
    <a href="/mostra" class="block text-gray-700 hover:text-blue-600 transition">Mostra</a>
    <a href="/contato" class="block bg-blue-600 text-white px-4 py-2 rounded-lg text-center hover:bg-blue-700 transition">
      Contato
    </a>
  </div>
</header>

<script>
  const menuButton = document.getElementById('menuButton');
  const mobileMenu = document.getElementById('mobileMenu');

  menuButton.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });
</script>