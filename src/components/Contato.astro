---
// src/components/Contato.astro
---

<section id="contato" class="relative py-24 px-6 overflow-hidden" style="background: #FAF3E0; border-bottom: 2px solid #2C1F15;">
  <div class="container mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-black tracking-tight leading-tight" style="color: #2C1F15;">
        Vamos criar algo <span class="gradient-text">incrível</span> juntos?
      </h2>
      <p class="text-lg mt-6" style="color: #4A3728; opacity: 0.8;">
        Estamos prontos para transformar sua visão em realidade. Fale conosco!
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6 max-w-6xl mx-auto">
      <!-- Main CTA Card -->
      <div class="p-10 flex flex-col justify-center" style="background: #2C1F15; border: 2px solid #2C1F15;">
        <h3 class="text-2xl font-display font-black mb-4" style="color: #FDF6E3;">Entre em contato</h3>
        <p class="mb-8" style="color: rgba(253,246,227,0.7);">
          Estamos prontos para transformar sua visão em realidade. Fale conosco sobre projetos de branding, design e estratégia.
        </p>
        
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 flex items-center justify-center text-xl" style="background: rgba(199,91,57,0.2);">📧</div>
            <div>
              <p class="text-xs font-mono uppercase tracking-wider" style="color: #E07B5B;">Email</p>
              <a href="mailto:kaipestudio@gmail.com" class="font-medium transition-colors" style="color: #FDF6E3;" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='#FDF6E3'">kaipestudio@gmail.com</a>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 flex items-center justify-center text-xl" style="background: rgba(199,91,57,0.2);">📱</div>
            <div>
              <p class="text-xs font-mono uppercase tracking-wider" style="color: #E07B5B;">WhatsApp</p>
              <a href="https://wa.me/556781282388" class="font-medium transition-colors" style="color: #FDF6E3;" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='#FDF6E3'">(67) 8128-2388</a>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 flex items-center justify-center text-xl" style="background: rgba(199,91,57,0.2);">📍</div>
            <div>
              <p class="text-xs font-mono uppercase tracking-wider" style="color: #E07B5B;">Localização</p>
              <p class="font-medium" style="color: #FDF6E3;">Dourados, MS</p>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex gap-3 mt-8">
          <a href="#" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: rgba(253,246,227,0.1); border: 2px solid rgba(253,246,227,0.2);" aria-label="Instagram" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='rgba(253,246,227,0.1)'">📸</a>
          <a href="#" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: rgba(253,246,227,0.1); border: 2px solid rgba(253,246,227,0.2);" aria-label="YouTube" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='rgba(253,246,227,0.1)'">▶️</a>
          <a href="#" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: rgba(253,246,227,0.1); border: 2px solid rgba(253,246,227,0.2);" aria-label="Twitter" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='rgba(253,246,227,0.1)'">🐦</a>
        </div>
      </div>

      <!-- Side Cards -->
      <div class="flex flex-col gap-6">
        <!-- Contact Form Card -->
        <div class="p-8 flex-1" style="background: #FDF6E3; border: 2px solid #2C1F15; box-shadow: 6px 6px 0 #2C1F15;">
          <h3 class="text-xl font-display font-bold mb-6" style="color: #2C1F15;">Envie uma mensagem</h3>
          <form class="space-y-4" netlify>
            <div>
              <input 
                type="text" 
                name="nome" 
                required 
                class="w-full px-4 py-3 outline-none transition-all"
                style="background: #FAF3E0; border: 2px solid #E8DFD0; color: #2C1F15;"
                placeholder="Seu nome"
              />
            </div>
            <div>
              <input 
                type="email" 
                name="email" 
                required 
                class="w-full px-4 py-3 outline-none transition-all"
                style="background: #FAF3E0; border: 2px solid #E8DFD0; color: #2C1F15;"
                placeholder="seu@email.com"
              />
            </div>
            <div>
              <textarea 
                name="mensagem" 
                rows="3" 
                required 
                class="w-full px-4 py-3 outline-none transition-all resize-none"
                style="background: #FAF3E0; border: 2px solid #E8DFD0; color: #2C1F15;"
                placeholder="Fale sobre seu projeto..."
              ></textarea>
            </div>
            <button 
              type="submit" 
              class="w-full btn-glow py-3"
            >
              Enviar Mensagem 🚀
            </button>
          </form>
        </div>

        <!-- Quick Contact Card -->
        <div class="p-6 text-center" style="background: rgba(199,91,57,0.1); border: 2px solid #C75B39;">
          <div class="text-3xl mb-3">💬</div>
          <h4 class="font-display font-bold" style="color: #2C1F15;">Resposta Rápida</h4>
          <p class="text-sm mt-1" style="color: #4A3728; opacity: 0.8;">Resposta em até 24 horas</p>
        </div>
      </div>
    </div>
  </div>
</section>