---
// src/components/Footer.astro
---

<footer class="relative py-16 px-6" style="background: #2C1F15; border-top: 2px solid #2C1F15;">
  <div class="container mx-auto max-w-7xl">
    <!-- Brand Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-12 pb-8" style="border-bottom: 2px solid rgba(253,246,227,0.15);">
      <div>
        <h3 class="text-2xl font-display font-black mb-2" style="color: #FDF6E3;">
          Kaipê<span style="color: #C75B39;">Studio</span>
        </h3>
        <p class="text-sm" style="color: rgba(253,246,227,0.5);">
          Editora, produtora cultural e estúdio de game design. Arte, tecnologia e educação desde 2024.
        </p>
      </div>
      <div class="flex gap-4">
        <a href="#" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: rgba(253,246,227,0.1); border: 2px solid rgba(253,246,227,0.15);" aria-label="Instagram" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='rgba(253,246,227,0.1)'">📸</a>
        <a href="#" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: rgba(253,246,227,0.1); border: 2px solid rgba(253,246,227,0.15);" aria-label="YouTube" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='rgba(253,246,227,0.1)'">▶️</a>
        <a href="#" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: rgba(253,246,227,0.1); border: 2px solid rgba(253,246,227,0.15);" aria-label="Twitter" onmouseover="this.style.background='#C75B39'" onmouseout="this.style.background='rgba(253,246,227,0.1)'">🐦</a>
      </div>
    </div>

    <!-- Three Columns -->
    <div class="grid md:grid-cols-3 gap-12">
      <!-- Links -->
      <div>
        <h4 class="text-xs font-mono font-semibold mb-6 uppercase tracking-widest" style="color: #C75B39;">Links</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Início</a></li>
          <li><a href="/quem-somos" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Quem Somos</a></li>
          <li><a href="/portfolio" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Portfólio</a></li>
          <li><a href="/editora" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Editora</a></li>
          <li><a href="/mostra" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Mostra</a></li>
          <li><a href="/rede-colaborativa" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Game Hub</a></li>
          <li><a href="/blog" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Blog</a></li>
          <li><a href="/contato" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">Contato</a></li>
        </ul>
      </div>

      <!-- Serviços -->
      <div>
        <h4 class="text-xs font-mono font-semibold mb-6 uppercase tracking-widest" style="color: #C75B39;">Serviços</h4>
        <ul class="space-y-3">
          <li><a href="/servicos/jogos-educativos" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">🎮 Jogos Educativos</a></li>
          <li><a href="/servicos/narrativas-interativas" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">📖 Narrativas Interativas</a></li>
          <li><a href="/servicos/gamificacao" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">🏆 Gamificação</a></li>
          <li><a href="/servicos/producao-cultural" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">🎭 Produção Cultural</a></li>
          <li><a href="/servicos/editora" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">📚 Editora</a></li>
          <li><a href="/servicos/oficinas" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">🎓 Oficinas</a></li>
        </ul>
      </div>

      <!-- Contato -->
      <div>
        <h4 class="text-xs font-mono font-semibold mb-6 uppercase tracking-widest" style="color: #C75B39;">Contato</h4>
        <ul class="space-y-4">
          <li class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center text-lg flex-shrink-0" style="background: rgba(199,91,57,0.2);">📧</div>
            <a href="mailto:kaipestudio@gmail.com" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">kaipestudio@gmail.com</a>
          </li>
          <li class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center text-lg flex-shrink-0" style="background: rgba(199,91,57,0.2);">📱</div>
            <a href="https://wa.me/556781282388" class="text-sm transition-colors" style="color: rgba(253,246,227,0.6);" onmouseover="this.style.color='#E07B5B'" onmouseout="this.style.color='rgba(253,246,227,0.6)'">(67) 8128-2388</a>
          </li>
          <li class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center text-lg flex-shrink-0" style="background: rgba(199,91,57,0.2);">📍</div>
            <span class="text-sm" style="color: rgba(253,246,227,0.6);">Dourados, MS</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 text-center text-sm" style="border-top: 2px solid rgba(253,246,227,0.1); color: rgba(253,246,227,0.3);">
      <p>© 2026 Kaipê Studio — Editora, Produtora Cultural e Game Design. Todos os direitos reservados.</p>
      <p class="mt-2">
        Feito com ❤️ usando Astro, Tailwind e Sveltia CMS
      </p>
    </div>
  </div>
</footer>