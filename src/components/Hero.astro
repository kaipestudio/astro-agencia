---
// src/components/Hero.astro
---

<section class="relative min-h-screen flex items-center overflow-hidden" style="background: linear-gradient(135deg, #FDF6E3 0%, #FAF3E0 100%); border-bottom: 2px solid #2C1F15;">
  <!-- Floating Orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div class="container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 px-6 py-32 relative z-10">
    <!-- Left Content -->
    <div class="flex flex-col justify-center">
      <!-- Badge -->
      <div class="inline-block px-4 py-2 mb-8 font-mono text-xs font-semibold uppercase tracking-widest" style="background: rgba(199,91,57,0.1); border: 2px solid #C75B39; color: #C75B39;">
        ✦ Editora · Produtora Cultural · Game Design
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-black leading-tight tracking-tight" style="color: #2C1F15;">
        Arte, <span class="gradient-text">tecnologia</span> e educação
      </h1>

      <p class="text-lg md:text-xl mt-6 max-w-xl leading-relaxed" style="color: #4A3728; opacity: 0.8;">
        Desenvolvemos jogos educativos, narrativas interativas, produções culturais, publicações editoriais e experiências imersivas que conectam arte e aprendizado.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="/portfolio" class="btn-glow text-center">
          Ver Portfólio
        </a>
        <a href="#contato" class="btn-glass text-center">
          Fale Conosco
        </a>
      </div>
    </div>

    <!-- Right Visual -->
    <div class="relative flex justify-center items-center">
      <div class="w-full max-w-md aspect-[4/5] flex items-center justify-center text-8xl relative" style="background: linear-gradient(135deg, #C75B39, #E07B5B); border: 4px solid #2C1F15;">
        <div class="absolute inset-3" style="border: 2px solid #FDF6E3;"></div>
        <span class="relative z-10">🎮</span>
        <!-- Ícones sobrepostos -->
        <span class="absolute top-4 left-4 text-3xl z-10" style="filter: drop-shadow(2px 2px 0 #2C1F15);">📚</span>
        <span class="absolute bottom-4 right-4 text-3xl z-10" style="filter: drop-shadow(2px 2px 0 #2C1F15);">🎭</span>
        <span class="absolute bottom-4 left-4 text-2xl z-10" style="filter: drop-shadow(2px 2px 0 #2C1F15);">📖</span>
        <span class="absolute top-4 right-4 text-2xl z-10" style="filter: drop-shadow(2px 2px 0 #2C1F15);">🏆</span>
      </div>
      
      <!-- Floating Badges -->
      <div class="absolute top-10 -right-4 px-4 py-2 font-mono text-xs font-bold uppercase" style="background: #FDF6E3; border: 3px solid #2C1F15; color: #2C1F15; animation: float 4s ease-in-out infinite;">
        Est. 2016
      </div>
      
      <div class="absolute bottom-20 -left-4 px-4 py-2 font-mono text-xs font-bold uppercase" style="background: #FDF6E3; border: 3px solid #2C1F15; color: #C75B39; animation: float 4s ease-in-out infinite 2s;">
        Dourados, MS
      </div>
    </div>
  </div>
</section>

<!-- Stats Bar -->
<div style="background: #FAF3E0; border-bottom: 2px solid #2C1F15;">
  <div class="container mx-auto grid grid-cols-2 md:grid-cols-4">
    <div class="py-12 px-6 text-center" style="border-right: 2px solid #2C1F15;">
      <p class="text-4xl font-display font-black" style="color: #C75B39;">3</p>
      <p class="text-xs font-mono uppercase tracking-widest mt-2" style="color: #4A3728;">Livros Publicados</p>
    </div>
    <div class="py-12 px-6 text-center" style="border-right: 2px solid #2C1F15;">
      <p class="text-4xl font-display font-black" style="color: #C75B39;">2</p>
      <p class="text-xs font-mono uppercase tracking-widest mt-2" style="color: #4A3728;">Protótipos de Jogos</p>
    </div>
    <div class="py-12 px-6 text-center" style="border-right: 2px solid #2C1F15;">
      <p class="text-4xl font-display font-black" style="color: #C75B39;">3</p>
      <p class="text-xs font-mono uppercase tracking-widest mt-2" style="color: #4A3728;">Edições da Mostra</p>
    </div>
    <div class="py-12 px-6 text-center">
      <p class="text-4xl font-display font-black" style="color: #C75B39;">9+</p>
      <p class="text-xs font-mono uppercase tracking-widest mt-2" style="color: #4A3728;">Anos de Trajetória</p>
    </div>
  </div>
</div>

<style>
  /* Estilos para as orbs flutuantes */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.3;
    pointer-events: none;
  }
  
  .orb-1 {
    width: 300px;
    height: 300px;
    top: -80px;
    right: -80px;
    background: #C75B39;
    animation: floatOrb 8s ease-in-out infinite;
  }
  
  .orb-2 {
    width: 200px;
    height: 200px;
    bottom: -60px;
    left: -60px;
    background: #5C6B4F;
    animation: floatOrb 10s ease-in-out infinite reverse;
  }
  
  .orb-3 {
    width: 150px;
    height: 150px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #D4A843;
    animation: floatOrb 6s ease-in-out infinite 1s;
  }

  @keyframes floatOrb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(20px, -20px) scale(1.1); }
    66% { transform: translate(-20px, 10px) scale(0.9); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
</style>