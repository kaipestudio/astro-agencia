---
// src/components/Hero.astro
---

<section class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-white to-purple-50 pt-20 px-4">
  <div class="container mx-auto text-center max-w-4xl">
    <!-- Badge -->
    <div class="inline-block bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-semibold mb-6">
      🚀 Transformando ideias em código
    </div>

    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-gray-900 leading-tight">
      Criamos experiências
      <span class="text-blue-600">digitais</span>
      que impactam
    </h1>

    <p class="text-lg md:text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
      Agência especializada em desenvolvimento web, design e estratégias digitais 
      para fazer seu negócio brilhar online.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#contato" class="bg-blue-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-700 transition shadow-lg hover:shadow-blue-200">
        Vamos Conversar
      </a>
      <a href="#portfolio" class="border-2 border-blue-600 text-blue-600 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-50 transition">
        Ver Portfólio
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-16 grid grid-cols-3 gap-4 max-w-2xl mx-auto">
      <div>
        <p class="text-3xl font-bold text-gray-900">50+</p>
        <p class="text-sm text-gray-600">Projetos</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-gray-900">98%</p>
        <p class="text-sm text-gray-600">Satisfação</p>
      </div>
      <div>
        <p class="text-3xl font-bold text-gray-900">4.9</p>
        <p class="text-sm text-gray-600">Avaliação</p>
      </div>
    </div>
  </div>
</section>