---
// src/components/Portfolio.astro
---

<section id="portfolio" class="py-20 px-4 bg-gray-50">
  <div class="container mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">Nosso Portfólio</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2">Projetos Recentes</h2>
      <p class="text-gray-600 mt-4">
        Conheça alguns dos projetos que desenvolvemos para nossos clientes
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Projeto 1 -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition group">
        <div class="h-48 bg-gradient-to-br from-blue-400 to-purple-400 flex items-center justify-center text-6xl">
          🏢
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold">Site Corporativo</h3>
          <p class="text-gray-600 mt-2">Empresa de tecnologia com design moderno</p>
          <a href="#" class="inline-block mt-4 text-blue-600 font-semibold hover:text-blue-800 transition">
            Ver projeto →
          </a>
        </div>
      </div>

      <!-- Projeto 2 -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition group">
        <div class="h-48 bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center text-6xl">
          🛍️
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold">E-commerce</h3>
          <p class="text-gray-600 mt-2">Loja virtual com experiência de compra fluida</p>
          <a href="#" class="inline-block mt-4 text-blue-600 font-semibold hover:text-blue-800 transition">
            Ver projeto →
          </a>
        </div>
      </div>

      <!-- Projeto 3 -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition group">
        <div class="h-48 bg-gradient-to-br from-green-400 to-blue-400 flex items-center justify-center text-6xl">
          📱
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold">App de Delivery</h3>
          <p class="text-gray-600 mt-2">Aplicativo web para restaurantes parceiros</p>
          <a href="#" class="inline-block mt-4 text-blue-600 font-semibold hover:text-blue-800 transition">
            Ver projeto →
          </a>
        </div>
      </div>
    </div>

    <div class="text-center mt-12">
      <a href="/portfolio" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition">
        Ver Todos os Projetos
      </a>
    </div>
  </div>
</section>