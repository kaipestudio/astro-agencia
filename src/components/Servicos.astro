---
// src/components/Servicos.astro
---

<section id="servicos" class="py-20 px-4 bg-white">
  <div class="container mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">Nossos Serviços</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2">O que oferecemos</h2>
      <p class="text-gray-600 mt-4">
        Soluções completas para levar sua marca ao próximo nível digital
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Serviço 1 -->
      <div class="group bg-gray-50 p-8 rounded-2xl hover:bg-blue-50 transition hover:shadow-lg">
        <div class="text-5xl mb-4">💻</div>
        <h3 class="text-xl font-bold mb-2">Desenvolvimento Web</h3>
        <p class="text-gray-600 group-hover:text-gray-800 transition">
          Sites e aplicações web modernas, rápidas e responsivas com as melhores tecnologias.
        </p>
      </div>

      <!-- Serviço 2 -->
      <div class="group bg-gray-50 p-8 rounded-2xl hover:bg-blue-50 transition hover:shadow-lg">
        <div class="text-5xl mb-4">🎨</div>
        <h3 class="text-xl font-bold mb-2">UI/UX Design</h3>
        <p class="text-gray-600 group-hover:text-gray-800 transition">
          Design centrado no usuário para criar experiências intuitivas e memoráveis.
        </p>
      </div>

      <!-- Serviço 3 -->
      <div class="group bg-gray-50 p-8 rounded-2xl hover:bg-blue-50 transition hover:shadow-lg">
        <div class="text-5xl mb-4">📱</div>
        <h3 class="text-xl font-bold mb-2">Apps & SPAs</h3>
        <p class="text-gray-600 group-hover:text-gray-800 transition">
          Aplicações Single Page Application com performance excepcional.
        </p>
      </div>

      <!-- Serviço 4 -->
      <div class="group bg-gray-50 p-8 rounded-2xl hover:bg-blue-50 transition hover:shadow-lg">
        <div class="text-5xl mb-4">🚀</div>
        <h3 class="text-xl font-bold mb-2">SEO & Performance</h3>
        <p class="text-gray-600 group-hover:text-gray-800 transition">
          Otimização para mecanismos de busca e performance para seu site voar.
        </p>
      </div>

      <!-- Serviço 5 -->
      <div class="group bg-gray-50 p-8 rounded-2xl hover:bg-blue-50 transition hover:shadow-lg">
        <div class="text-5xl mb-4">📊</div>
        <h3 class="text-xl font-bold mb-2">Marketing Digital</h3>
        <p class="text-gray-600 group-hover:text-gray-800 transition">
          Estratégias para atrair, converter e fidelizar clientes online.
        </p>
      </div>

      <!-- Serviço 6 -->
      <div class="group bg-gray-50 p-8 rounded-2xl hover:bg-blue-50 transition hover:shadow-lg">
        <div class="text-5xl mb-4">🔧</div>
        <h3 class="text-xl font-bold mb-2">Manutenção</h3>
        <p class="text-gray-600 group-hover:text-gray-800 transition">
          Suporte contínuo, atualizações e melhorias para seu projeto.
        </p>
      </div>
    </div>
  </div>
</section>