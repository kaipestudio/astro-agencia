---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
---

<Layout title="Blog - Kaipê Studio" description="Notícias, artigos e novidades da Kaipê Studio">
  <section class="py-20 px-4 bg-gray-50">
    <div class="container mx-auto max-w-6xl">
      <h1 class="text-4xl md:text-5xl font-bold text-center mb-12">Blog</h1>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition group">
            <div class="h-48 bg-gradient-to-br from-blue-400 to-purple-400 flex items-center justify-center text-6xl">
              📝
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold group-hover:text-blue-600 transition">{post.data.title}</h3>
              <p class="text-sm text-gray-500 mt-1">{post.data.date?.toLocaleDateString('pt-BR')}</p>
              <p class="text-gray-600 mt-2 line-clamp-2">{post.data.description || 'Leia mais sobre este post...'}</p>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="text-center text-gray-500 text-lg">Nenhum post publicado ainda.</p>
      )}
    </div>
  </section>
</Layout>